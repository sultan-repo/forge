FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir pytest

RUN useradd --create-home --uid 10001 scorer

WORKDIR /scorer
COPY assert_run.py score_entrypoint.py fixture_bundle.json.gz.b64 /scorer/
RUN python - <<'PY'
import base64
import gzip
from pathlib import Path

root = Path('/scorer')
encoded = (root / 'fixture_bundle.json.gz.b64').read_text(encoding='ascii')
(root / 'fixture_bundle.json').write_bytes(gzip.decompress(base64.b64decode(encoded)))
PY
RUN chmod -R a-w /scorer

USER scorer
ENV HOME=/tmp/scorer-home \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTEST_DISABLE_PLUGIN_AUTOLOAD=1

ENTRYPOINT []
